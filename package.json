{
	"name": "gustimei",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"start:test": "node --env-file=.env.test build",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format:check": "prettier --check .",
		"lint": "npm run format:check && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"benchmark:phase1": "vitest --run --config vitest.phase1.config.ts",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "npm run build && node scripts/run-e2e.mjs",
		"test:e2e:install": "playwright install --with-deps chromium",
		"ci": "npm run lint && npm run check && npm run test:unit && npm run build",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:test:reset": "node --env-file=.env.test scripts/reset-test-database.mjs",
		"db:studio": "drizzle-kit studio",
		"test:db": "npm run db:test:reset && node --env-file=.env.test node_modules/vitest/vitest.mjs --run --config vitest.database.config.ts",
		"catalogue:import:restaurants": "vite-node scripts/import-osm.ts",
		"catalogue:audit:restaurants": "vite-node scripts/audit-catalogue.ts",
		"catalogue:roles": "vite-node scripts/catalogue-roles.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"better-auth": "~1.4.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.31.0",
		"osm-pbf-parser": "^2.3.0"
	}
}

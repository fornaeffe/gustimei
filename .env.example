# Copy this file to .env for local development only.
APP_ENV="development"
DATABASE_URL="postgres://gustimei:gustimei-development@localhost:5432/gustimei_development"
ORIGIN="http://localhost:5173"

# Generate a local value with at least 32 characters. Never reuse it outside development.
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# OSM defaults are suitable for modest interactive development use. Configure an OSM-derived
# provider before traffic exceeds the public services' usage policies.
OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"

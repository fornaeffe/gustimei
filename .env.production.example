APP_ENV="production"
DATABASE_URL="postgres://USER:PASSWORD@PRODUCTION_DATABASE_HOST:5432/gustimei_production"
ORIGIN="https://example.com"
BETTER_AUTH_SECRET="replace-with-a-production-only-high-entropy-secret"
OSM_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"

# Phase 8 deployment contract. Use secret files or the deployment environment; never commit values.
GUSTIMEI_IMAGE="ghcr.io/OWNER/gustimei@sha256:REPLACE_WITH_64_HEX_CHARACTERS"
GUSTIMEI_OPS_IMAGE="ghcr.io/OWNER/gustimei-ops@sha256:REPLACE_WITH_64_HEX_CHARACTERS"
MIGRATION_DATABASE_URL="postgres://MIGRATION_USER:PASSWORD@PRODUCTION_DATABASE_HOST:5432/gustimei_production"
BACKUP_DATABASE_URL="postgres://BACKUP_USER:PASSWORD@PRODUCTION_DATABASE_HOST:5432/gustimei_production"
OPERATOR_DATABASE_URL="postgres://OPERATOR_USER:PASSWORD@PRODUCTION_DATABASE_HOST:5432/gustimei_production"
DEPLOYMENT_SSH_PRINCIPAL="gustimei-deploy"

EMAIL_PROVIDER="brevo"
BREVO_API_KEY="replace-at-deployment"
OBJECT_STORAGE_PROVIDER="cloudflare-r2"
R2_JURISDICTION="eu"
R2_ENDPOINT="https://ACCOUNT_ID.eu.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="replace-at-deployment"
R2_SECRET_ACCESS_KEY="replace-at-deployment"
R2_EVIDENCE_BUCKET="gustimei-production-evidence"
R2_ARTIFACT_BUCKET="gustimei-production-artifacts"
R2_BACKUP_BUCKET="gustimei-production-backups"
BACKUP_AGE_RECIPIENT="age1replacewithpublicrecipient"

MONITORING_PROVIDER="better-stack"
BETTER_STACK_SOURCE_TOKEN="replace-at-deployment"
BETTER_STACK_UPTIME_URL="https://uptime.betterstack.example/replace"
BETTER_STACK_CRON_REVIEW_URL="https://uptime.betterstack.example/replace"
BETTER_STACK_CRON_BACKUP_URL="https://uptime.betterstack.example/replace"
BETTER_STACK_CRON_RECOMMENDATIONS_URL="https://uptime.betterstack.example/replace"
JOB_PROVIDER="durable"
